{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "outDir": "out",
        "lib": ["es2022"],
        "types": ["node"],
        "esModuleInterop": true,
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "noEmitOnError": true
    },
    "include": ["src"],
    "exclude": ["node_modules", ".vscode-test"]
}
