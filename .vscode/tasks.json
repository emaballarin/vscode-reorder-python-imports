// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            // Type checks and bundles, so that `dist/extension.js` is current
            // before the extension host launches.
            "type": "npm",
            "script": "build",
            "problemMatcher": "$tsc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            // Background type checking while editing; the bundle is rebuilt by
            // the `watch` script or by the build task above.
            "type": "npm",
            "script": "watch:tsc",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "presentation": {
                "reveal": "never"
            }
        }
    ]
}
